# Angel One SmartAPI credentials — copy this file to `.env` and fill in your
# own real values there. `.env` is gitignored and will never be committed.
#
# Claude does not read, type, or use these values. This file only documents
# what gate0/providers/smartapi_client.py expects to find in the environment
# at runtime, for YOU to run yourself (or for a separately authorized
# process) — see comms/PROTOCOL.md "Phase B" for why.

# From the Angel One SmartAPI developer portal (https://smartapi.angelone.in)
SMARTAPI_API_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_PASSWORD_OR_PIN=
SMARTAPI_TOTP_SECRET=

# Optional: override the default historical-data rate limit (requests/second).
# Leave unset to use the documented default (3 req/s, 180/min).
SMARTAPI_MAX_REQ_PER_SEC=
